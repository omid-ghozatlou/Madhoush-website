---
layout: base.njk
title: آرشیو
permalink: /archive/
---

<!-- Hero Section -->
<section class="banner banner-1" style="height: 50vh;">
    <div class="banner-content fade-in">
        <h1>{{ page_titles.archive.title }}</h1>
        <p>{{ page_titles.archive.subtitle }}</p>
    </div>
</section>

<!-- Archive Grid -->
<section class="content-section" style="max-width: 1200px; margin: 0 auto;">
    <div class="grid" style="grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));">
        {% for item in collections.archiveItems %}
        <a href="{{ item.url }}" class="card fade-in" style="text-decoration: none; color: inherit;">
            {% if item.data.thumbnail %}
            <img src="{{ item.data.thumbnail }}" alt="{{ item.data.title }}" loading="lazy" class="gallery-image" style="height: 350px;">
            {% else %}
            <div style="width: 100%; height: 350px; background: linear-gradient(135deg, var(--accent-tertiary), var(--accent-color)); display: flex; align-items: center; justify-content: center; font-size: 3rem;">🎶</div>
            {% endif %}
            <h3>{{ item.data.title }}</h3>
            {% if item.data.description %}
            <p>{{ item.data.description }}</p>
            {% endif %}
            {% if item.data.spotify_url or item.data.apple_music_url or item.data.youtube_url or item.data.soundcloud_url %}
            <div class="platform-links" style="margin-top: 1rem;">
                {% if item.data.spotify_url %}<span class="platform-icon" style="pointer-events: none;"><i class="fab fa-spotify"></i></span>{% endif %}
                {% if item.data.apple_music_url %}<span class="platform-icon" style="pointer-events: none;"><i class="fab fa-apple"></i></span>{% endif %}
                {% if item.data.youtube_url %}<span class="platform-icon" style="pointer-events: none;"><i class="fab fa-youtube"></i></span>{% endif %}
                {% if item.data.soundcloud_url %}<span class="platform-icon" style="pointer-events: none;"><i class="fab fa-soundcloud"></i></span>{% endif %}
            </div>
            {% endif %}
        </a>
        {% endfor %}
    </div>

    {% if collections.archiveItems.length == 0 %}
    <p style="text-align: center; color: var(--text-secondary); font-size: 1.2rem; padding: 3rem 0;">
        هنوز آیتمی در آرشیو وجود ندارد.
    </p>
    {% endif %}
</section>
