---
layout: base.njk
title: فروشگاه
permalink: /store/
---

<!-- Hero Section -->
<section class="banner banner-3" style="height: 50vh;">
    <div class="banner-content fade-in">
        <h1>{{ page_titles.store.title }}</h1>
        <p>{{ page_titles.store.subtitle }}</p>
    </div>
</section>
<!-- Store Grid -->
<section class="content-section" style="max-width: 1200px; margin: 0 auto;">

<!-- Store Profiles -->
<div class="store-profiles-wrapper">
    <div class="store-profiles">
        {% for profile in collections.storeProfiles %}
        <a href="{{ profile.url }}" class="store-profile">
            {% if profile.data.avatar %}
        <img
            src="{{ profile.data.avatar }}"
            alt="{{ profile.data.title }}"
            class="store-profile-avatar">
        {% endif %}
            <span>{{ profile.data.title }}</span>
        </a>
        {% endfor %}
    </div>
</div>


<!-- Store Categories -->

<div style="margin-bottom:60px;">

    <div style="
        display:flex;
        flex-wrap:wrap;
        gap:25px;
        justify-content:center;
    ">

    {% for category in collections.storeCategories | sort(attribute='data.order') %}

        <a
            href="{{ category.url }}"
            style="
                width:220px;
                text-decoration:none;
                color:inherit;
            ">

            <div class="card fade-in">

                {% if category.data.thumbnail %}
                <img
                    src="{{ category.data.thumbnail }}"
                    alt="{{ category.data.title }}"
                    class="gallery-image"
                    style="height:180px;">
                {% endif %}

                <h3 style="text-align:center;">
                    {{ category.data.title }}
                </h3>

                {% if category.data.description %}
                <p style="text-align:center;">
                    {{ category.data.description }}
                </p>
                {% endif %}

            </div>

        </a>

    {% endfor %}

    </div>

</div>
    <div class="grid">
        {% for item in collections.storeItems %}
        <a href="{{ item.url }}" class="card fade-in" style="text-decoration: none; color: inherit;">
            {% if item.data.thumbnail %}
            <img src="{{ item.data.thumbnail }}" alt="{{ item.data.title }}" loading="lazy" class="gallery-image" style="height: 300px;">
            {% else %}
            <div style="width: 100%; height: 300px; background: linear-gradient(135deg, var(--accent-color), var(--accent-secondary)); display: flex; align-items: center; justify-content: center; font-size: 3rem;">📚</div>
            {% endif %}
            <h3>{{ item.data.title }}</h3>
            {% if item.data.category %}

{% set currentCategory = collections.storeCategories
    | selectattr("data.slug", "equalto", item.data.category)
    | first %}

<p style="color:var(--accent-color);font-size:.9rem;">

📦

{% if currentCategory %}
{{ currentCategory.data.title }}
{% else %}
{{ item.data.category }}
{% endif %}

</p>

{% endif %}
            {% if item.data.price %}
            <p style="color: var(--accent-secondary); font-weight: bold;">{{ item.data.price }}</p>
            {% endif %}
            {% if item.data.description %}
            <p>{{ item.data.description }}</p>
            {% endif %}
        </a>
        {% endfor %}
    </div>

    {% if collections.storeItems.length == 0 %}
    <p style="text-align: center; color: var(--text-secondary); font-size: 1.2rem; padding: 3rem 0;">
        به‌زودی محصولات فروشگاه اضافه خواهند شد.
    </p>
    {% endif %}
</section>
