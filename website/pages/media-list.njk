---
layout: base.njk
title: بیگ مد
permalink: /media/
---

<!-- Hero Section -->
<section class="banner banner-4" style="height: 50vh;">
    <div class="banner-content fade-in">
        <h1>گالری رسانه</h1>
        <p>دنیای بصری ما را کاوش کنید</p>
    </div>
</section>

<!-- Media Grid -->
<section class="content-section" style="max-width: 1200px; margin: 0 auto;">
    <div class="grid" style="grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));">
        {% for item in collections.mediaItems %}
        <a href="{{ item.url }}" class="card fade-in gallery-item" style="text-decoration: none; color: inherit;">
            {% if item.data.thumbnail %}
            <img src="{{ item.data.thumbnail }}" alt="{{ item.data.title }}" loading="lazy" class="gallery-image">
            {% elif item.data.type == "ویدیو" %}
            <div style="width: 100%; height: 250px; background: linear-gradient(135deg, var(--accent-color), var(--accent-secondary)); display: flex; align-items: center; justify-content: center; font-size: 5rem; cursor: pointer;">▶</div>
            {% else %}
            <div style="width: 100%; height: 250px; background: linear-gradient(135deg, var(--accent-color), var(--accent-secondary)); display: flex; align-items: center; justify-content: center; font-size: 3rem;">📷</div>
            {% endif %}
            <h3>{{ item.data.title }}</h3>
            {% if item.data.description %}
            <p>{{ item.data.description }}</p>
            {% endif %}
        </a>
        {% endfor %}
    </div>

    {% if collections.mediaItems.length == 0 %}
    <p style="text-align: center; color: var(--text-secondary); font-size: 1.2rem; padding: 3rem 0;">
        هنوز رسانه‌ای منتشر نشده است.
    </p>
    {% endif %}
</section>
