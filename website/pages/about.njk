---
layout: base.njk
title: داستان ما
permalink: /about/
---

<!-- Hero Section -->
<section class="banner banner-1" style="height: 60vh;">
    <div class="banner-content fade-in">
        <h1>{{ about.hero_title }}</h1>
        <p>{{ about.hero_subtitle }}</p>
    </div>
</section>

<!-- Band Story Section -->
<section class="content-section">
    <h2 class="section-title">{{ about.hero_subtitle }}</h2>
    <div style="max-width: 900px; margin: 0 auto; text-align: center;">
        <div class="about-story">{{ about.story | markdownify | safe }}</div>
    </div>
</section>

<!-- Band Members Section -->
<section class="content-section" style="background-color: var(--secondary-bg); padding: 5rem 2rem;">
    <h2 class="section-title">اعضای گروه</h2>
    <div class="grid">
        {% for member in collections.members %}
        <div class="card fade-in">
            {% set bgColor = "linear-gradient(135deg, var(--accent-color), #1a1a1a)" %}
            {% if member.data.accent_color == "pink" %}
                {% set bgColor = "linear-gradient(135deg, var(--accent-secondary), #1a1a1a)" %}
            {% elif member.data.accent_color == "yellow" %}
                {% set bgColor = "linear-gradient(135deg, var(--accent-tertiary), #1a1a1a)" %}
            {% elif member.data.accent_color == "gradient" %}
                {% set bgColor = "linear-gradient(135deg, #00d9ff, var(--accent-secondary))" %}
            {% endif %}
            <div style="width: 100%; height: 300px; background: {{ bgColor }}; display: flex; align-items: center; justify-content: center; margin-bottom: 1rem; font-size: 4rem; font-weight: bold;">{{ member.data.code_name }}</div>
            <h3><span dir="ltr">{{ member.data.name }}</span></h3>
            <p><strong>{{ member.data.role }}</strong></p>
            <p style="margin-top: 1rem;">{{ member.data.description }}</p>
        </div>
        {% endfor %}
    </div>
</section>
