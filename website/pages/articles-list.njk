---
layout: base.njk
title: مقالات
permalink: /articles/
---

<!-- Hero Section -->
<section class="banner banner-1" style="height: 50vh;">
    <div class="banner-content fade-in">
        <h1>مقالات</h1>
        <p>نوشته‌ها و داستان‌های مدهوش</p>
    </div>
</section>

<!-- Articles Grid -->
<section class="content-section" style="max-width: 1200px; margin: 0 auto;">
    <div class="articles-grid">
        {% for article in collections.articles %}
        <a href="{{ article.url }}" class="article-card fade-in" style="text-decoration: none; color: inherit;">
            <div class="article-card-image">
                {% if article.data.thumbnail %}
                <img src="{{ article.data.thumbnail }}" alt="{{ article.data.title }}">
                {% else %}
                <div style="width: 100%; height: 100%; background: linear-gradient(135deg, var(--accent-color), var(--accent-secondary)); display: flex; align-items: center; justify-content: center; font-size: 3rem;">📝</div>
                {% endif %}
            </div>
            <div class="article-card-content">
                <h3>{{ article.data.title }}</h3>
                <div class="article-card-meta">
                    <span>{{ article.data.date | persianDate }}</span>
                    <span>&nbsp;|&nbsp;</span>
                    <span>{{ article.data.author }}</span>
                </div>
                {% if article.data.description %}
                <p>{{ article.data.description }}</p>
                {% endif %}
            </div>
        </a>
        {% endfor %}
    </div>

    {% if collections.articles.length == 0 %}
    <p style="text-align: center; color: var(--text-secondary); font-size: 1.2rem; padding: 3rem 0;">
        هنوز مقاله‌ای منتشر نشده است.
    </p>
    {% endif %}
</section>
