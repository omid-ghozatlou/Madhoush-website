---
layout: base.njk
title: مدمگ
permalink: /madmag/
---

<!-- Hero Section -->
<section class="banner banner-2" style="height: 50vh;">
    <div class="banner-content fade-in">
        <h1>مدمگ، ژانرگسترِ</h1>
        <p>در ژانرگستر، هر هفته سروقتِ یکی از ژانرهای موسیقی جهانی می‌ریم — {{ collections.madmag.length | persianDigits }} شماره</p>
    </div>
</section>

<!-- Madmag Grid -->
<section class="content-section" style="max-width: 1200px; margin: 0 auto;">
    <div class="articles-grid">
        {% for item in collections.madmag %}
        <a href="{{ item.url }}" class="article-card fade-in" style="text-decoration: none; color: inherit;">
            <div class="article-card-image">
                {% if item.data.thumbnail %}
                <img src="{{ item.data.thumbnail }}" alt="{{ item.data.title }}" loading="lazy">
                {% else %}
                <div style="width: 100%; height: 100%; background: linear-gradient(135deg, var(--accent-color), var(--accent-secondary)); display: flex; align-items: center; justify-content: center; font-size: 3rem;">🎵</div>
                {% endif %}
            </div>
            <div class="article-card-content">
                {% if item.data.issue_number %}
                <span class="article-card-category">{{ item.data.issue_number }}</span>
                {% endif %}
                <h3>{{ item.data.title }}</h3>
                <div class="article-card-meta">
                    <span>{{ item.data.date | persianDate }}</span>
                    <span>&nbsp;|&nbsp;</span>
                    <span>{{ item.data.author }}</span>
                </div>
                {% if item.data.description %}
                <p>{{ item.data.description }}</p>
                {% endif %}
            </div>
        </a>
        {% endfor %}
    </div>

    {% if collections.madmag.length == 0 %}
    <p style="text-align: center; color: var(--text-secondary); font-size: 1.2rem; padding: 3rem 0;">
        هنوز شماره‌ای منتشر نشده است.
    </p>
    {% endif %}
</section>
