---
layout: base.njk
---

<!-- Store Item Hero -->
<section class="banner banner-3" style="height: 50vh; position: relative;">
    {% if thumbnail %}
    <div style="position: absolute; top: 0; left: 0; right: 0; bottom: 0;">
        <img src="{{ thumbnail }}" alt="{{ title }}" loading="lazy" style="width: 100%; height: 100%; object-fit: cover; opacity: 0.3;">
    </div>
    {% endif %}
    <div class="banner-content fade-in" style="position: relative; z-index: 10;">
        <h1 style="font-size: 3rem;">{{ title }}</h1>
        {% if book_author %}
        <p style="color: var(--accent-color); margin-top: 0.5rem;">{{ book_author }}</p>
        {% endif %}
        {% if price %}
        <p style="font-size: 1.4rem; color: var(--accent-secondary); margin-top: 1rem;">{{ price }}</p>
        {% endif %}
    </div>
</section>

<!-- Store Item Body -->
<section class="content-section" style="max-width: 800px; margin: 0 auto; padding: 3rem 2rem;">
    {% if thumbnail %}
    <div style="text-align: center; margin-bottom: 2rem;">
        <img src="{{ thumbnail }}" alt="{{ title }}" loading="lazy" style="max-width: 300px; box-shadow: 0 25px 70px rgba(0, 217, 255, 0.2);">
    </div>
    {% endif %}

    <div class="article-body">
        {{ content | safe }}
    </div>

    {% if buy_link %}
    <div style="text-align: center; margin-top: 2rem;">
        <a href="{{ buy_link }}" target="_blank" class="banner-btn" style="display: inline-block;">خرید</a>
    </div>
    {% endif %}

    <div style="margin-top: 4rem; padding-top: 2rem; border-top: 1px solid rgba(255,255,255,0.1);">
        <a href="/store/" class="banner-btn" style="display: inline-block;">
            بازگشت به فروشگاه →
        </a>
    </div>
</section>
