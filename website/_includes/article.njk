---
layout: base.njk
---

<!-- Article Hero -->
<section class="banner banner-1" style="height: 50vh; position: relative;">
    {% if thumbnail %}
    <div style="position: absolute; top: 0; left: 0; right: 0; bottom: 0;">
        <img src="{{ thumbnail }}" alt="{{ title }}" style="width: 100%; height: 100%; object-fit: cover; opacity: 0.3;">
    </div>
    {% endif %}
    <div class="banner-content fade-in" style="position: relative; z-index: 10;">
        <h1 style="font-size: 3rem;">{{ title }}</h1>
        <div style="display: flex; gap: 1rem; justify-content: center; align-items: center; margin-top: 1rem; flex-wrap: wrap;">
            <span style="color: var(--accent-color);">{{ author }}</span>
            <span style="color: var(--text-secondary);">|</span>
            <span style="color: var(--text-secondary);">{{ date | persianDate }}</span>
            <span style="color: var(--text-secondary);">|</span>
            <span style="color: var(--text-secondary);"><i class="fas fa-clock" style="margin-left: 0.3rem;"></i>{{ content | readingTime }}</span>
        </div>
        {% if description %}
        <p style="font-size: 1.1rem; color: var(--text-secondary); margin-top: 1.5rem; max-width: 600px; margin-right: auto; margin-left: auto;">{{ description }}</p>
        {% endif %}
    </div>
</section>

<!-- Article Body -->
<section class="content-section" style="max-width: 800px; margin: 0 auto; padding: 3rem 2rem;">
    <div class="article-body">
        {{ content | safe }}
    </div>

    <!-- Share & Back -->
    <div style="margin-top: 4rem; padding-top: 2rem; border-top: 1px solid rgba(255,255,255,0.1); display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
        <a href="/articles/" class="banner-btn" style="display: inline-block;">
            ← بازگشت به مقالات
        </a>
    </div>
</section>
