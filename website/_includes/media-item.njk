---
layout: base.njk
---

<!-- Media Item Hero -->
<section class="banner banner-4" style="height: 50vh; position: relative;">
    {% if thumbnail %}
    <div style="position: absolute; top: 0; left: 0; right: 0; bottom: 0;">
        <img src="{{ thumbnail }}" alt="{{ title }}" loading="lazy" style="width: 100%; height: 100%; object-fit: cover; opacity: 0.3;">
    </div>
    {% endif %}
    <div class="banner-content fade-in" style="position: relative; z-index: 10;">
        <h1 style="font-size: 3rem;">{{ title }}</h1>
        <p style="color: var(--text-secondary); margin-top: 1rem;">{{ date | persianDate }}</p>
    </div>
</section>

<!-- Media Item Body -->
<section class="content-section" style="max-width: 800px; margin: 0 auto; padding: 3rem 2rem;">
    {% if type == "ویدیو" and video_url %}
    <div style="position: relative; padding-bottom: 56.25%; height: 0; overflow: hidden; margin-bottom: 2rem;">
        <iframe src="{{ video_url }}" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; border: 0;" allowfullscreen></iframe>
    </div>
    {% elif thumbnail %}
    <div style="text-align: center; margin-bottom: 2rem;">
        <img src="{{ thumbnail }}" alt="{{ title }}" loading="lazy" style="max-width: 100%; box-shadow: 0 25px 70px rgba(0, 217, 255, 0.2);">
    </div>
    {% endif %}

    {% if description %}
    <p style="font-size: 1.1rem; color: var(--text-secondary); margin-bottom: 2rem;">{{ description }}</p>
    {% endif %}

    <div class="article-body">
        {{ content | safe }}
    </div>

    <div style="margin-top: 4rem; padding-top: 2rem; border-top: 1px solid rgba(255,255,255,0.1);">
        <a href="/media/" class="banner-btn" style="display: inline-block;">
            بازگشت به بیگ مد →
        </a>
    </div>
</section>
