<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    {% set _title = title + " — " + settings.site_title if title else settings.site_title %}
    {% set _desc = description if description else settings.default_description %}
    {% set _image = thumbnail if thumbnail else settings.default_image %}
    {% set _url = settings.site_url + page.url %}

    <title>{{ _title }}</title>
    <meta name="description" content="{{ _desc }}">
    {% if author %}<meta name="author" content="{{ author }}">{% endif %}

    <!-- Canonical -->
    <link rel="canonical" href="{{ _url }}">

    <!-- Open Graph -->
    <meta property="og:site_name" content="{{ settings.site_title }}">
    <meta property="og:title" content="{{ _title }}">
    <meta property="og:description" content="{{ _desc }}">
    <meta property="og:url" content="{{ _url }}">
    <meta property="og:image" content="{{ settings.site_url }}{{ _image }}">
    <meta property="og:locale" content="fa_IR">
    <meta property="og:type" content="{{ 'article' if date else 'website' }}">
    {% if date %}
    <meta property="article:published_time" content="{{ date | dateToISO }}">
    {% endif %}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ _title }}">
    <meta name="twitter:description" content="{{ _desc }}">
    <meta name="twitter:image" content="{{ settings.site_url }}{{ _image }}">

    <!-- JSON-LD structured data -->
    {% if date %}
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Article",
      "headline": {{ title | dump | safe }},
      "description": {{ _desc | dump | safe }},
      "image": "{{ settings.site_url }}{{ _image }}",
      "datePublished": "{{ date | dateToISO }}",
      "author": { "@type": "Person", "name": {{ (author or settings.site_title) | dump | safe }} },
      "publisher": {
        "@type": "MusicGroup",
        "name": "{{ settings.site_title }}",
        "url": "{{ settings.site_url }}"
      },
      "url": "{{ _url }}"
    }
    </script>
    {% else %}
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "MusicGroup",
      "name": "{{ settings.site_title }}",
      "url": "{{ settings.site_url }}",
      "description": {{ _desc | dump | safe }},
      "sameAs": [
        {% if settings.social.instagram %}"{{ settings.social.instagram }}"{% if settings.social.spotify %},{% endif %}{% endif %}
        {% if settings.social.spotify %}"{{ settings.social.spotify }}"{% if settings.social.youtube %},{% endif %}{% endif %}
        {% if settings.social.youtube %}"{{ settings.social.youtube }}"{% endif %}
      ]
    }
    </script>
    {% endif %}

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/styles/main.css">
    <script src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
</head>
<body>
    <!-- Header -->
    <header>
        <nav>
            <a href="/index.html" class="logo-right">
                <img src="/images/right_logo.PNG" alt="مدهوش">
            </a>
            <ul class="nav-links" id="navLinks">
                {% for item in nav.items | sort(false, false, 'order') %}
                <li><a href="{{ item.url }}">{{ item.label }}</a></li>
                {% endfor %}
            </ul>
            <div class="menu-toggle" id="menuToggle">
                <span></span>
                <span></span>
                <span></span>
            </div>
            <a href="/index.html" class="logo-left">
                <img src="/images/left_logo.PNG" alt="مدهوش">
            </a>
        </nav>
    </header>

    <!-- Main Content -->
    <main>
        {{ content | safe }}
    </main>

    <!-- Footer -->
    <footer>
        <div class="social-links">
            {% if settings.social.instagram %}<a href="{{ settings.social.instagram }}" target="_blank" aria-label="اینستاگرام"><i class="fab fa-instagram"></i></a>{% endif %}
            {% if settings.social.telegram %}<a href="{{ settings.social.telegram }}" target="_blank" aria-label="تلگرام"><i class="fab fa-telegram"></i></a>{% endif %}
            {% if settings.social.twitter %}<a href="{{ settings.social.twitter }}" target="_blank" aria-label="توییتر"><i class="fab fa-twitter"></i></a>{% endif %}
            {% if settings.social.facebook %}<a href="{{ settings.social.facebook }}" target="_blank" aria-label="فیسبوک"><i class="fab fa-facebook"></i></a>{% endif %}
            {% if settings.social.youtube %}<a href="{{ settings.social.youtube }}" target="_blank" aria-label="یوتیوب"><i class="fab fa-youtube"></i></a>{% endif %}
            {% if settings.social.spotify %}<a href="{{ settings.social.spotify }}" target="_blank" aria-label="اسپاتیفای"><i class="fab fa-spotify"></i></a>{% endif %}
            {% if settings.social.soundcloud %}<a href="{{ settings.social.soundcloud }}" target="_blank" aria-label="ساندکلاود"><i class="fab fa-soundcloud"></i></a>{% endif %}
        </div>
        <p>&copy; {{ settings.footer_copyright }}</p>
    </footer>

    <!-- Music Player -->
    <div class="music-player" id="musicPlayer">
        <div class="player-container">
            <!-- Track Info -->
            <div class="track-info">
                <div class="album-art" id="albumArt">
                    <img src="/images/Gorbeh.PNG" alt="Album Art">
                </div>
                <div class="track-details">
                    <div class="track-title" id="trackTitle">گربه</div>
                    <div class="track-artist" id="trackArtist">مدهوش</div>
                </div>
            </div>

            <!-- Player Controls -->
            <div class="player-controls">
                <div class="control-buttons">
                    <button class="control-btn" id="prevBtn" aria-label="قبلی">
                        <i class="fas fa-step-backward"></i>
                    </button>
                    <button class="control-btn play-btn" id="playBtn" aria-label="پخش">
                        <i class="fas fa-play"></i>
                    </button>
                    <button class="control-btn" id="nextBtn" aria-label="بعدی">
                        <i class="fas fa-step-forward"></i>
                    </button>
                </div>
                <div class="progress-container">
                    <span class="time" id="currentTime">0:00</span>
                    <div class="progress-bar" id="progressBar">
                        <div class="progress" id="progress">
                            <div class="progress-handle" id="progressHandle"></div>
                        </div>
                    </div>
                    <span class="time" id="duration">0:00</span>
                </div>
            </div>

            <!-- Volume and Playlist -->
            <div class="player-extras">
                <button class="control-btn" id="playlistBtn" aria-label="لیست پخش">
                    <i class="fas fa-list"></i>
                </button>
                <div class="volume-control">
                    <button class="control-btn" id="volumeBtn" aria-label="صدا">
                        <i class="fas fa-volume-up"></i>
                    </button>
                    <div class="volume-slider" id="volumeSlider">
                        <div class="volume-bar">
                            <div class="volume-fill" id="volumeFill"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Playlist -->
        <div class="playlist" id="playlist">
            <div class="playlist-header">
                <h3>لیست پخش</h3>
                <button class="close-playlist" id="closePlaylist">
                    <i class="fas fa-times"></i>
                </button>
            </div>
            <div class="playlist-items" id="playlistItems"></div>
        </div>
    </div>

    <!-- Hidden Audio Element -->
    <audio id="audioPlayer"></audio>

    <script>window.PLAYLIST = {{ playlist.tracks | dump | safe }};</script>
    <script src="/scripts/main.js"></script>
    <script>
      if (window.netlifyIdentity) {
        window.netlifyIdentity.on("init", function(user) {
          if (!user) {
            window.netlifyIdentity.on("login", function() {
              document.location.href = "/admin/";
            });
          }
        });
      }
    </script>
</body>
</html>
