---
layout: base.njk
---

<section class="content-section" style="max-width:1200px;margin:auto;">

{% if avatar %}
<img
    src="{{ avatar }}"
    alt="{{ title }}"
    class="store-profile-avatar"
    style="width:120px;height:120px;margin-bottom:20px;">
{% endif %}

<h1>{{ title }}</h1>

{% if description %}
<p>{{ description }}</p>
{% endif %}

<hr style="margin:30px 0;">

<h2>محصولات</h2>

<div class="grid">

{% for item in collections.storeItems %}
    {% if item.data.store_profile == slug %}

    <a href="{{ item.url }}" class="card" style="text-decoration:none;color:inherit;">

        {% if item.data.thumbnail %}
        <img src="{{ item.data.thumbnail }}" class="gallery-image">
        {% endif %}

        <h3>{{ item.data.title }}</h3>

        {% if item.data.price %}
        <p>{{ item.data.price }}</p>
        {% endif %}

        {% if item.data.description %}
        <p>{{ item.data.description }}</p>
        {% endif %}

    </a>

    {% endif %}
{% endfor %}

</div>

</section>
