---
layout: base.njk
---

<!-- Hero -->

<section class="banner banner-3" style="height:50vh;">

    <div class="banner-content fade-in">

        <h1>{{ title }}</h1>

        {% if description %}
        <p>{{ description }}</p>
        {% endif %}

    </div>

</section>

<!-- Products -->

<section class="content-section" style="max-width:1200px;margin:0 auto;">

    <div class="grid">

        {% for item in collections.storeItems %}

            {% if item.data.category == slug %}

            <a href="{{ item.url }}" class="card fade-in" style="text-decoration:none;color:inherit;">

                {% if item.data.thumbnail %}

                    <img
                        src="{{ item.data.thumbnail }}"
                        alt="{{ item.data.title }}"
                        loading="lazy"
                        class="gallery-image"
                        style="height:300px;">

                {% else %}

                    <div style="height:300px;background:#222;"></div>

                {% endif %}

                <h3>{{ item.data.title }}</h3>

                {% if item.data.price %}
                <p style="color:var(--accent-secondary);font-weight:bold;">
                    {{ item.data.price }}
                </p>
                {% endif %}

                {% if item.data.description %}
                <p>{{ item.data.description }}</p>
                {% endif %}

            </a>

            {% endif %}

        {% endfor %}

    </div>

</section>
